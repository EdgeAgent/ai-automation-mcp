# Copy to .env for live (non-demo) runs. Demos and tests never read this file.
# The servers in this repo are model-agnostic: no LLM API key is needed.
# These settings only steer the local demo servers when you run them live.

# Server 03 (notes-files): the sandboxed directory notes live in.
AI_MCP_NOTES_DIR=mcp-notes
# Server 06 (mini-crm): where the local JSON lead store persists.
AI_MCP_CRM_PATH=.ai-mcp-crm.json
# Server 04 (web-fetch): comma-separated domain allowlist. Empty = any domain.
AI_MCP_FETCH_ALLOWLIST=
